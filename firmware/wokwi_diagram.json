{
  "version": 1,
  "author": "DrowsiGuard ECE Project",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -140,
      "left": 40,
      "attrs": { "i2cAddress": "0x3c" }
    },
    { "type": "wokwi-led", "id": "led-green", "top": 60, "left": -110, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "led-red", "top": 120, "left": -110, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 70, "left": -60, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 130, "left": -60, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 200, "left": -80, "attrs": { "hasVolume": "1" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "oled:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:22", "oled:SCL", "yellow", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "blue", [ "v0" ] ],
    [ "esp:19", "r1:1", "green", [ "h0" ] ],
    [ "r1:2", "led-green:A", "green", [ "h0" ] ],
    [ "led-green:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:18", "r2:1", "orange", [ "h0" ] ],
    [ "r2:2", "led-red:A", "red", [ "h0" ] ],
    [ "led-red:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:23", "bz1:2", "purple", [ "h0" ] ],
    [ "bz1:1", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {
    "Adafruit GFX Library": "1.11.9",
    "Adafruit SSD1306": "2.5.9",
    "PubSubClient": "2.8",
    "ArduinoJson": "6.21.3"
  }
}
